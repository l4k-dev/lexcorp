<?php

require __DIR__ . '/vendor/autoload.php';

define('BASE_PATH', __DIR__);

$command = $argv[1] ?? null;


switch ($command) {

    case 'seed':

        foreach (glob(BASE_PATH . '/database/seeders/*.php') as $file) {

            require $file;

        }

        break;


    default:

        echo "Comando inválido\n";

}